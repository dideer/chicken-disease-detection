            <!-- Diseases Found -->
            <div class="col-md-4 mb-3">
                <div class="stat-card">
                    <div class="stat-icon" style="color: #c0392b;">
                        <i class="fas fa-virus"></i>
                    </div>
                    <div class="stat-number" 
                         id="statDiseases" 
                         style="color: #c0392b;">0</div>
                    <div class="stat-label" data-lang-key="diseases_found">
                        Diseases Found
