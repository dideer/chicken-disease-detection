        .badge-fowlpox {
            background-color: #e67e22;
            color: white;
        }

        .badge-healthy {
            background-color: #27ae60;
            color: white;
        }

        .history-image {
            width: 50px;
            height: 50px;
            object-fit: cover;
            border-radius: 6px;
        }
    </style>
</head>
