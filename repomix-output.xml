    <!-- Bootstrap JS -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
    <!-- Main JS -->
    <script src="main.js"></script>

    <script>
        // ================================================
        // PAGE LOAD
        // ================================================
        window.addEventListener('load', function () {
            loadLanguage();
            const username = localStorage.getItem('loggedInUser');
            const isAdmin = localStorage.getItem('isAdmin') === 'true' ||
                (username && username.toLowerCase() === 'admin');

            if (isAdmin) {
                window.location.href = 'admin.html';
                return;
            }

            document.getElementById('userDisplay').textContent = 
                username || 'Guest';

            const authActionBtn = document.getElementById('authActionBtn');
            if (!username) {
                authActionBtn.innerHTML = 
                    '<i class="fas fa-sign-in-alt me-1"></i> Login';
                authActionBtn.onclick = function () {
                    window.location.href = 'login.html';
                };
            }

            // Load real data
            loadStatistics();
            loadHistory();
        });

        // ================================================
        // FILE UPLOAD HANDLING
        // ================================================
        const fileInput = document.getElementById('fileInput');
        const uploadZone = document.getElementById('uploadZone');
        const previewContainer = document.getElementById('previewContainer');

        fileInput.addEventListener('change', handleFileSelect);

        uploadZone.addEventListener('dragover', (e) => {
            e.preventDefault();
            uploadZone.classList.add('drag-over');
        });

        uploadZone.addEventListener('dragleave', () => {
            uploadZone.classList.remove('drag-over');
        });

        uploadZone.addEventListener('drop', (e) => {
            e.preventDefault();
            uploadZone.classList.remove('drag-over');
            fileInput.files = e.dataTransfer.files;
            handleFileSelect();
        });

        function handleFileSelect() {
            const file = fileInput.files[0];
            if (!file || !file.type.startsWith('image/')) {
                showError('Please select a valid image file');
                return;
            }

            const reader = new FileReader();
            reader.onload = function (e) {
                document.getElementById('preview').src = e.target.result;
                localStorage.setItem('uploadedImage', e.target.result);
                previewContainer.style.display = 'block';
                uploadZone.style.display = 'none';
                document.getElementById('fileName').textContent = file.name;
                document.getElementById('fileSize').textContent = 
                    formatFileSize(file.size);
                hideError();
            };
            reader.readAsDataURL(file);
        }

        function resetUpload() {
            fileInput.value = '';
            previewContainer.style.display = 'none';
            uploadZone.style.display = 'block';
            localStorage.removeItem('uploadedImage');
            hideError();
        }

        function formatFileSize(bytes) {
            if (bytes === 0) return '0 Bytes';
            const k = 1024;
            const sizes = ['Bytes', 'KB', 'MB'];
            const i = Math.floor(Math.log(bytes) / Math.log(k));
            return Math.round(bytes / Math.pow(k, i) * 100) / 100 
                   + ' ' + sizes[i];
        }

        // ================================================
        // AI DISEASE DETECTION
        // ================================================
        async function detectDisease() {
            const file = fileInput.files[0];
            const username = localStorage.getItem('loggedInUser') || 'guest';

            if (!file) {
                showError('Please upload an image first');
                return;
            }

            // Show loading overlay
            document.getElementById('loadingOverlay').classList.add('show');
            document.getElementById('detectBtn').disabled = true;

            try {
                const formData = new FormData();
                formData.append('file', file);
                formData.append('username', username);

                const response = await fetch('/api/predict', {
                    method: 'POST',
                    body: formData
                });

                const result = await response.json();

                if (result.success) {
                    // Save full result to localStorage
                    localStorage.setItem('detectionResult', JSON.stringify({
                        disease: result.predicted_class,
                        confidence: result.confidence,
                        allConfidences: result.probabilities,
                        disease_info: result.disease_info,
                        image_name: result.image_name
                    }));

                    // Go to result page
                    window.location.href = 'result.html';

                } else {
                    showError('Detection failed: ' + result.message);
                    document.getElementById('detectBtn').disabled = false;
                }

            } catch (error) {
                showError('Cannot connect to server. Please try again.');
                console.error('Prediction error:', error);
                document.getElementById('detectBtn').disabled = false;
            } finally {
                document.getElementById('loadingOverlay')
                    .classList.remove('show');
            }
        }

        // ================================================
        // LOAD REAL STATISTICS FROM DATABASE
        // ================================================
        async function loadStatistics() {
            try {
                const response = await fetch('/api/statistics');
                const data = await response.json();

                if (data.success) {
                    const stats = data.statistics;
                    const diseases = (stats.crd || 0) + 
                                     (stats.fowlpox || 0);
                    document.getElementById('statTotal').textContent = 
                        data.total;
                    document.getElementById('statDiseases').textContent = 
                        diseases;
                    document.getElementById('statHealthy').textContent = 
                        stats.healthy || 0;
                }
            } catch (error) {
                console.error('Failed to load statistics:', error);
            }
        }

        // ================================================
        // LOAD DETECTION HISTORY FROM DATABASE
        // ================================================
        async function loadHistory() {
            const tbody = document.getElementById('historyTableBody');

            try {
                const username = localStorage.getItem('loggedInUser');
                const url = username
                    ? `/api/history?username=${username}`
                    : '/api/history';

                const response = await fetch(url);
                const data = await response.json();

                if (data.success && data.detections.length > 0) {
                    tbody.innerHTML = data.detections
                        .slice(0, 10) // Show last 10
                        .map(d => `
                        <tr>
                            <td class="px-4 py-3">
                                <img src="/uploads/${d.image_name}" 
                                     class="history-image"
                                     onerror="this.src='https://via.placeholder.com/50x50?text=IMG'"
                                     alt="chicken">
                            </td>
                            <td class="py-3">
                                <i class="fas fa-user me-1 text-muted"></i>
                                ${d.username}
                            </td>
                            <td class="py-3">
                                <span class="badge badge-${d.predicted_class} px-3 py-2">
                                    ${d.predicted_class.toUpperCase()}
                                </span>
                            </td>
                            <td class="py-3">
                                <div class="d-flex align-items-center">
                                    <div class="progress me-2" 
                                         style="width: 80px; height: 8px;">
                                        <div class="progress-bar bg-success" 
                                             style="width: ${d.confidence}%">
                                        </div>
                                    </div>
                                    <small>${d.confidence}%</small>
                                </div>
                            </td>
                            <td class="py-3">
                                <small class="text-muted">
                                    <i class="fas fa-clock me-1"></i>
                                    ${formatDate(d.detected_at)}
                                </small>
                            </td>
                        </tr>
                    `).join('');
                } else {
                    tbody.innerHTML = `
                        <tr>
                            <td colspan="5" 
                                class="text-center py-4 text-muted">
                                <i class="fas fa-inbox me-2"></i>
                                No detections yet. Upload an image to start!
                            </td>
                        </tr>`;
                }
            } catch (error) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="5" 
                            class="text-center py-4 text-danger">
                            <i class="fas fa-exclamation-circle me-2"></i>
                            Failed to load history
                        </td>
                    </tr>`;
            }
        }

        // ================================================
        // HELPER FUNCTIONS
        // ================================================
        function formatDate(dateStr) {
            const date = new Date(dateStr);
            return date.toLocaleDateString() + ' ' + 
                   date.toLocaleTimeString([], {
                       hour: '2-digit', 
                       minute: '2-digit'
                   });
        }

        function showError(message) {
            const alert = document.getElementById('errorAlert');
            document.getElementById('errorMessage').textContent = message;
            alert.classList.remove('d-none');
        }

        function hideError() {
            document.getElementById('errorAlert').classList.add('d-none');
        }

        function logout() {
            localStorage.removeItem('loggedInUser');
            localStorage.removeItem('isAdmin');
            localStorage.removeItem('currentUser');
            localStorage.removeItem('authToken');
            localStorage.removeItem('uploadedImage');
            localStorage.removeItem('detectionResult');
            window.location.href = 'login.html';
        }
    </script>
</body>
</html>
</file>

