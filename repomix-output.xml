    <script>
        async function ensureAdminSession() {
            if (!localStorage.getItem('authToken')) {
                window.location.href = 'login.html';
                return null;
            }

            let me;
            try {
                me = await apiFetch('/api/me');
            } catch (error) {
                logout();
                return null;
            }

            if (!me.success || !me.user || !me.user.is_admin) {
                logout();
                return null;
            }

            localStorage.setItem('loggedInUser', me.user.username);
            localStorage.setItem('currentUser', JSON.stringify(me.user));
            localStorage.setItem('isAdmin', 'true');
            document.getElementById('adminName').textContent = me.user.username;
            return me.user;
        }

        async function loadSummary() {
            const response = await apiFetch('/api/admin/summary');
            if (!response.success) return;
            const summary = response.summary || {};
            document.getElementById('summaryUsers').textContent = summary.total_users || 0;
            document.getElementById('summaryDetections').textContent = summary.total_detections || 0;
            document.getElementById('summaryChickens').textContent = summary.total_chickens_detected || 0;
            document.getElementById('summaryDiseases').textContent = summary.total_disease_cases || 0;
        }

        window.addEventListener('load', async function () {
            const user = await ensureAdminSession();
            if (!user) return;
            await loadSummary();
        });
    </script>
</body>
</html>
