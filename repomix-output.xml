                    <div class="col-lg-6">
                        <div class="panel p-4 h-100">
                            <div class="d-flex align-items-center gap-3 mb-2">
                                <span class="metric-icon mi-users"><i class="bi bi-person-gear"></i></span>
                                <h2 class="h5 fw-bold mb-0">User Management</h2>
                            </div>
                            <p class="text-muted">Add, edit, activate, deactivate, search, and delete user accounts.</p>
                            <button class="btn btn-brand px-4" onclick="showSection('users')">
                                <i class="bi bi-people me-2"></i> Open Users
                            </button>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="panel p-4 h-100">
                            <div class="d-flex align-items-center gap-3 mb-2">
                                <span class="metric-icon mi-detections"><i class="bi bi-images"></i></span>
                                <h2 class="h5 fw-bold mb-0">Detection History</h2>
                            </div>
                            <p class="text-muted">View thumbnails, filter by date or result, preview images, and delete records.</p>
                            <button class="btn btn-outline-success rounded-pill px-4" onclick="showSection('detections')">
                                <i class="bi bi-clock-history me-2"></i> Open Detections
                            </button>
                        </div>
                    </div>
                </div>
            </section>

            <!-- ============ USERS SECTION ============ -->
            <section class="section-view" id="section-users">
                <div class="panel p-4">
                    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
                        <div>
                            <h2 class="h4 fw-bold mb-1">User Management</h2>
                            <p class="text-muted mb-0">Manage administrator and standard user accounts.</p>
                        </div>
                        <button class="btn btn-brand px-4" data-bs-toggle="modal" data-bs-target="#userModal" onclick="openAddUserModal()">
                            <i class="bi bi-person-plus me-2"></i> Add User
                        </button>
                    </div>

                    <div class="toolbar-grid mb-4">
                        <input id="userSearch" class="form-control" type="search" placeholder="Search by name or email">
                        <select id="userRoleFilter" class="form-select">
                            <option value="">All Roles</option>
                            <option value="admin">Admin</option>
                            <option value="user">User</option>
                        </select>
                        <select id="userStatusFilter" class="form-select">
                            <option value="">All Statuses</option>
                            <option value="active">Active</option>
                            <option value="inactive">Inactive</option>
                        </select>
                        <button class="btn btn-outline-secondary rounded-pill" onclick="loadUsers()">
                            <i class="bi bi-funnel me-2"></i> Apply Filters
                        </button>
                    </div>

                    <div class="table-responsive">
                        <table class="table align-middle" id="usersDataTable">
                            <thead>
                                <tr>
                                    <th>User ID</th>
                                    <th>Name</th>
                                    <th>Email</th>
                                    <th>Role</th>
                                    <th>Status</th>
                                    <th>Created Date</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="usersTableBody">
                                <tr><td colspan="7" class="empty-state">Loading users...</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>

            <!-- ============ DETECTIONS SECTION ============ -->
            <section class="section-view" id="section-detections">
                <div class="panel p-4">
                    <div class="mb-4">
                        <h2 class="h4 fw-bold mb-1">Detection History</h2>
                        <p class="text-muted mb-0">Filter detection records and preview uploaded images.</p>
                    </div>

                    <div class="toolbar-grid mb-4">
                        <input id="detectionSearch" class="form-control" type="search" placeholder="Search by user or result">
                        <select id="resultFilter" class="form-select">
                            <option value="">All Results</option>
                            <option value="crd">CRD</option>
                            <option value="fowlpox">Fowl Pox</option>
                            <option value="healthy">Healthy</option>
                            <option value="chicken">Chicken</option>
                            <option value="no_chicken">No Chicken</option>
                        </select>
                        <input id="dateFromFilter" class="form-control" type="date">
                        <input id="dateToFilter" class="form-control" type="date">
                        <button class="btn btn-outline-secondary rounded-pill" onclick="loadDetections()">
                            <i class="bi bi-funnel me-2"></i> Apply Filters
                        </button>
                    </div>

                    <div class="table-responsive">
                        <table class="table align-middle" id="detectionsDataTable">
                            <thead>
                                <tr>
                                    <th>Detection ID</th>
                                    <th>Image</th>
                                    <th>Result</th>
                                    <th>Confidence</th>
                                    <th>Date &amp; Time</th>
                                    <th>Uploaded By</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="detectionsTableBody">
                                <tr><td colspan="7" class="empty-state">Loading detection history...</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>

        </main>
    </div>

    <!-- ============ USER MODAL ============ -->
    <div class="modal fade" id="userModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header border-0 p-4">
                    <div>
                        <h3 class="h5 fw-bold mb-1" id="userModalTitle">Add User</h3>
                        <p class="text-muted mb-0">Manage administrator and standard user accounts.</p>
                    </div>
                    <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4 pt-0">
                    <form id="userForm">
                        <input type="hidden" id="userIdField">
                        <div class="mb-3">
                            <label class="form-label">Name</label>
                            <input id="userNameField" class="form-control" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Email</label>
                            <input id="userEmailField" class="form-control" type="email" required>
                        </div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Role</label>
                                <select id="userRoleField" class="form-select" required>
                                    <option value="user">User</option>
                                    <option value="admin">Admin</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Status</label>
                                <select id="userStatusField" class="form-select" required>
                                    <option value="active">Active</option>
                                    <option value="inactive">Inactive</option>
                                </select>
                            </div>
                        </div>
                        <div class="mt-3">
                            <label class="form-label">Password</label>
                            <input id="userPasswordField" class="form-control" type="password" placeholder="Leave blank when editing to keep current password">
                        </div>
                        <div id="userFormAlert" class="alert alert-danger d-none mt-3 mb-0"></div>
                    </form>
                </div>
                <div class="modal-footer border-0 px-4 pb-4">
                    <button class="btn btn-outline-secondary rounded-pill px-4" type="button" data-bs-dismiss="modal">Cancel</button>
                    <button class="btn btn-brand px-4" type="button" onclick="submitUserForm()">Save User</button>
                </div>
            </div>
        </div>
    </div>

    <!-- ============ IMAGE MODAL ============ -->
    <div class="modal fade" id="imageModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header border-0 p-4">
                    <h3 class="h5 fw-bold mb-0">Detection Image</h3>
                    <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4 pt-0 text-center">
                    <img id="fullImagePreview" class="img-fluid rounded-4" alt="Detection preview">
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
    <script src="main.js"></script>

    <script>
        // ================================================
        // STATE
        // ================================================
        let userModal;
        let imageModal;
        let usersTable;
        let detectionsTable;
        let currentSection = 'overview';
        let loadedSections = { overview: false, users: false, detections: false };

        const sectionMeta = {
            overview:   { title: 'Overview',          sub: 'Key metrics across the whole system' },
            users:      { title: 'User Management',   sub: 'Manage admins and standard users' },
            detections: { title: 'Detection History', sub: 'Filter records and preview images' }
        };

        // ================================================
        // SIDEBAR / NAVIGATION
        // ================================================
        function showSection(section) {
            currentSection = section;

            document.querySelectorAll('.section-view').forEach(el => el.classList.remove('active'));
            document.getElementById(`section-${section}`).classList.add('active');

            document.querySelectorAll('.side-link[data-section]').forEach(btn => {
                btn.classList.toggle('active', btn.dataset.section === section);
            });

            document.getElementById('pageTitle').textContent = sectionMeta[section].title;
            document.getElementById('pageSub').textContent = sectionMeta[section].sub;

            closeSidebar();

            // Lazy-load each section the first time it is opened
            if (!loadedSections[section]) {
                loadedSections[section] = true;
                if (section === 'users') loadUsers();
                if (section === 'detections') loadDetections();
            }
        }

        function refreshCurrentSection() {
            if (currentSection === 'overview') loadSummary();
            if (currentSection === 'users') loadUsers();
            if (currentSection === 'detections') loadDetections();
        }

        function openSidebar() {
            document.getElementById('sidebar').classList.add('open');
            document.getElementById('sidebarBackdrop').classList.add('show');
        }

        function closeSidebar() {
            document.getElementById('sidebar').classList.remove('open');
            document.getElementById('sidebarBackdrop').classList.remove('show');
        }

        // ================================================
        // SESSION
        // ================================================
        async function ensureAdminSession() {
            if (!localStorage.getItem('authToken')) {
                window.location.href = 'login.html';
                return null;
            }
            let me;
            try {
                me = await apiFetch('/api/me');
            } catch (error) {
                logout();
                return null;
            }
            if (!me.success || !me.user || !me.user.is_admin) {
                logout();
                return null;
            }
            localStorage.setItem('loggedInUser', me.user.username);
            localStorage.setItem('currentUser', JSON.stringify(me.user));
            localStorage.setItem('isAdmin', 'true');
            document.getElementById('adminName').textContent = me.user.username;
            document.getElementById('adminAvatar').textContent = getInitials(me.user.username);
            return me.user;
        }

        // ================================================
        // OVERVIEW
        // ================================================
        async function loadSummary() {
            const response = await apiFetch('/api/admin/summary');
            if (!response.success) return;
            const summary = response.summary || {};
            document.getElementById('summaryUsers').textContent = summary.total_users || 0;
            document.getElementById('summaryDetections').textContent = summary.total_detections || 0;
            document.getElementById('summaryChickens').textContent = summary.total_chickens_detected || 0;
            document.getElementById('summaryDiseases').textContent = summary.total_disease_cases || 0;
        }

        // ================================================
        // USERS
        // ================================================
        async function loadUsers() {
            const params = new URLSearchParams();
            const search = document.getElementById('userSearch').value.trim();
            const role = document.getElementById('userRoleFilter').value;
            const status = document.getElementById('userStatusFilter').value;
            if (search) params.set('search', search);
            if (role) params.set('role', role);
            if (status) params.set('status', status);

            const tbody = document.getElementById('usersTableBody');
            tbody.innerHTML = '<tr><td colspan="7" class="empty-state">Loading users...</td></tr>';

            const response = await apiFetch(`/api/admin/users?${params.toString()}`);
            if (!response.success || !response.users.length) {
                tbody.innerHTML = '<tr><td colspan="7" class="empty-state">No users match the current filters.</td></tr>';
                refreshUsersDataTable();
                return;
            }

            tbody.innerHTML = response.users.map(user => `
                <tr>
                    <td class="fw-semibold">#${user.id}</td>
                    <td>
                        <div class="user-chip">
                            <span class="user-avatar">${getInitials(user.username)}</span>
                            <div>
                                <div class="fw-semibold">${escapeHtml(user.username)}</div>
                                <div class="small text-muted">${user.detection_count} detections</div>
                            </div>
                        </div>
                    </td>
                    <td>${escapeHtml(user.email)}</td>
                    <td><span class="badge ${user.role === 'admin' ? 'bg-warning text-dark' : 'bg-light text-dark'} pill-badge">${capitalize(user.role)}</span></td>
                    <td><span class="badge ${user.status === 'active' ? 'bg-success-subtle text-success-emphasis' : 'bg-secondary-subtle text-secondary-emphasis'} pill-badge">${capitalize(user.status)}</span></td>
                    <td>${formatDate(user.created_at)}</td>
                    <td class="text-end">
                        <button class="btn btn-sm btn-outline-primary rounded-pill me-1" title="Edit" onclick='openEditUserModal(${JSON.stringify(user).replace(/'/g, "&apos;")})'><i class="bi bi-pencil"></i></button>
                        <button class="btn btn-sm btn-outline-${user.status === 'active' ? 'warning' : 'success'} rounded-pill me-1" title="Toggle status" onclick="toggleUserStatus(${user.id}, '${user.status}')"><i class="bi bi-power"></i></button>
                        <button class="btn btn-sm btn-outline-danger rounded-pill" title="Delete" onclick="deleteUser(${user.id}, '${escapeJs(user.username)}')"><i class="bi bi-trash"></i></button>
                    </td>
                </tr>
            `).join('');
            refreshUsersDataTable();
        }

        function refreshUsersDataTable() {
            if (usersTable) {
                usersTable.destroy();
            }
            usersTable = $('#usersDataTable').DataTable({
                responsive: true,
                pageLength: 5,
                lengthMenu: [5, 10, 25, 50],
                order: [[0, 'desc']],
                columnDefs: [
                    { orderable: false, targets: 6 }
                ]
            });
        }

        function openAddUserModal() {
            document.getElementById('userModalTitle').textContent = 'Add User';
            document.getElementById('userForm').reset();
            document.getElementById('userIdField').value = '';
            document.getElementById('userPasswordField').required = true;
            hideUserAlert();
        }

        function openEditUserModal(user) {
            const parsed = typeof user === 'string' ? JSON.parse(user) : user;
            document.getElementById('userModalTitle').textContent = 'Edit User';
            document.getElementById('userIdField').value = parsed.id;
            document.getElementById('userNameField').value = parsed.username;
            document.getElementById('userEmailField').value = parsed.email;
            document.getElementById('userRoleField').value = parsed.role;
            document.getElementById('userStatusField').value = parsed.status;
            document.getElementById('userPasswordField').value = '';
            document.getElementById('userPasswordField').required = false;
            hideUserAlert();
            userModal.show();
        }

        async function submitUserForm() {
            const id = document.getElementById('userIdField').value;
            const payload = {
                username: document.getElementById('userNameField').value.trim(),
                email: document.getElementById('userEmailField').value.trim(),
                role: document.getElementById('userRoleField').value,
                status: document.getElementById('userStatusField').value,
                password: document.getElementById('userPasswordField').value
            };

            if (!payload.username || !payload.email || (!id && !payload.password)) {
                showUserAlert('Please complete all required fields.');
                return;
            }

            const response = await apiFetch(id ? `/api/admin/users/${id}` : '/api/admin/users', {
                method: id ? 'PUT' : 'POST',
                body: JSON.stringify(payload)
            });

            if (!response.success) {
                showUserAlert(response.message || 'Failed to save user.');
                return;
            }

            userModal.hide();
            await loadUsers();
        }

        async function toggleUserStatus(userId, currentStatus) {
            const nextStatus = currentStatus === 'active' ? 'inactive' : 'active';
            if (!confirm(`Set this user to ${nextStatus}?`)) return;
            const response = await apiFetch(`/api/admin/users/${userId}/status`, {
                method: 'PATCH',
                body: JSON.stringify({ status: nextStatus })
            });
            if (!response.success) {
                alert(response.message || 'Failed to update user status.');
                return;
            }
            await loadUsers();
        }

        async function deleteUser(userId, username) {
            if (!confirm(`Delete user "${username}"? This action cannot be undone.`)) return;
            const response = await apiFetch(`/api/admin/users/${userId}`, { method: 'DELETE' });
            if (!response.success) {
                alert(response.message || 'Failed to delete user.');
                return;
            }
            await loadUsers();
        }

        function showUserAlert(message) {
            const alertBox = document.getElementById('userFormAlert');
            alertBox.textContent = message;
            alertBox.classList.remove('d-none');
        }

        function hideUserAlert() {
            const alertBox = document.getElementById('userFormAlert');
            alertBox.textContent = '';
            alertBox.classList.add('d-none');
        }

        // ================================================
        // DETECTIONS
        // ================================================
        async function loadDetections() {
            const params = new URLSearchParams();
            const search = document.getElementById('detectionSearch').value.trim();
            const result = document.getElementById('resultFilter').value;
            const dateFrom = document.getElementById('dateFromFilter').value;
            const dateTo = document.getElementById('dateToFilter').value;
            if (search) params.set('search', search);
            if (result) params.set('result', result);
            if (dateFrom) params.set('date_from', dateFrom);
            if (dateTo) params.set('date_to', dateTo);

            const tbody = document.getElementById('detectionsTableBody');
            tbody.innerHTML = '<tr><td colspan="7" class="empty-state">Loading detection history...</td></tr>';

            const response = await apiFetch(`/api/admin/detections?${params.toString()}`);
            if (!response.success || !response.detections.length) {
                tbody.innerHTML = '<tr><td colspan="7" class="empty-state">No detections match the current filters.</td></tr>';
                refreshDetectionsDataTable();
                return;
            }

            tbody.innerHTML = response.detections.map(detection => `
                <tr>
                    <td class="fw-semibold">#${detection.id}</td>
                    <td><img src="${escapeHtml(detection.image_url)}" class="thumb" alt="Detection image" onerror="this.src='https://via.placeholder.com/58x58?text=IMG'"></td>
                    <td><span class="pill-badge ${resultClass(detection.predicted_class)}">${formatResult(detection.predicted_class)}</span></td>
                    <td>${Number(detection.confidence || 0).toFixed(2)}%</td>
                    <td>${formatDateTime(detection.detected_at)}</td>
                    <td><div class="fw-semibold">${escapeHtml(detection.username || 'Unknown')}</div><div class="small text-muted">${escapeHtml(detection.email || '')}</div></td>
                    <td class="text-end">
                        <button class="btn btn-sm btn-outline-secondary rounded-pill me-1" title="Preview image" onclick="viewImage('${escapeJs(detection.image_url)}')"><i class="bi bi-image"></i></button>
                        <button class="btn btn-sm btn-outline-danger rounded-pill" title="Delete" onclick="deleteDetection(${detection.id})"><i class="bi bi-trash"></i></button>
                    </td>
                </tr>
            `).join('');
            refreshDetectionsDataTable();
        }

        function refreshDetectionsDataTable() {
            if (detectionsTable) {
                detectionsTable.destroy();
            }
            detectionsTable = $('#detectionsDataTable').DataTable({
                responsive: true,
                pageLength: 5,
                lengthMenu: [5, 10, 25, 50],
                order: [[0, 'desc']],
                columnDefs: [
                    { orderable: false, targets: [1, 6] }
                ]
            });
        }

        function viewImage(imageUrl) {
            document.getElementById('fullImagePreview').src = imageUrl;
            imageModal.show();
        }

        async function deleteDetection(detectionId) {
            if (!confirm('Delete this detection record?')) return;
            const response = await apiFetch(`/api/admin/detections/${detectionId}`, { method: 'DELETE' });
            if (!response.success) {
                alert(response.message || 'Failed to delete detection record.');
                return;
            }
            await loadDetections();
        }

        // ================================================
        // HELPERS
        // ================================================
        function formatDate(value) {
            return new Date(value).toLocaleDateString();
        }

        function formatDateTime(value) {
            const date = new Date(value);
            return `${date.toLocaleDateString()} ${date.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}`;
        }

        function formatResult(value) {
            return capitalize((value || '').replace('_', ' '));
        }

        function resultClass(value) {
            const key = (value || '').toLowerCase();
            return `result-${key}`;
        }

        function getInitials(name) {
            return (name || 'A').split(' ').map(part => part[0]).join('').slice(0, 2).toUpperCase();
        }

        function capitalize(value) {
            if (!value) return '';
            return value.charAt(0).toUpperCase() + value.slice(1);
        }

        function escapeHtml(value) {
            return String(value || '').replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;').replaceAll('"', '&quot;').replaceAll("'", '&#39;');
        }

        function escapeJs(value) {
            return String(value || '').replaceAll('\\', '\\\\').replaceAll("'", "\\'");
        }

        // ================================================
        // PAGE LOAD
        // ================================================
        window.addEventListener('load', async function () {
            userModal = new bootstrap.Modal(document.getElementById('userModal'));
            imageModal = new bootstrap.Modal(document.getElementById('imageModal'));

            const user = await ensureAdminSession();
            if (!user) return;

            loadedSections.overview = true;
            await loadSummary();
        });
    </script>
</body>
</html>
</file>

<file path="frontend/dashboard.html">
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chicken Disease Detection - Dashboard</title>
    
    <!-- Bootstrap 5 CDN -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome for icons -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    
    <!-- Custom styles -->
    <link href="style.css" rel="stylesheet">
    
    <!-- Translations -->
    <script src="lang.js"></script>

    <style>
        .upload-zone {
            border: 3px dashed #1a6b3c;
            border-radius: 12px;
            padding: 40px 20px;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s;
            background-color: #f8faf7;
        }

        .upload-zone:hover {
            background-color: #e8f5f0;
            border-color: #0d3d20;
        }

        .upload-zone.drag-over {
            background-color: #d4edda;
            border-color: #0d3d20;
        }

        .upload-icon {
            font-size: 3rem;
            color: #1a6b3c;
            margin-bottom: 10px;
        }

        .image-preview-container {
            margin-top: 20px;
            display: none;
        }

        .image-preview {
            max-width: 100%;
            max-height: 300px;
            border-radius: 8px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }

        .file-info {
            margin-top: 15px;
            padding: 15px;
            background-color: #f8f9fa;
            border-left: 4px solid #1a6b3c;
            border-radius: 4px;
        }

        .stat-card {
            text-align: center;
            padding: 25px 15px;
            border-radius: 8px;
            background: white;
            border: 1px solid #e9ecef;
        }

        .stat-number {
            font-size: 2.5rem;
            font-weight: bold;
            color: #1a6b3c;
        }

        .stat-label {
            color: #6c757d;
            margin-top: 10px;
            font-size: 0.95rem;
        }

        .stat-icon {
            font-size: 2rem;
            color: #1a6b3c;
            margin-bottom: 10px;
        }

        .farmer-tip {
            border-left: 5px solid #f39c12;
            padding: 15px;
            background-color: #fffbf0;
            border-radius: 4px;
            margin-bottom: 20px;
        }

        .farmer-tip-icon {
            color: #f39c12;
            font-size: 1.3rem;
            margin-right: 10px;
        }

        /* Loading overlay */
        .loading-overlay {
            display: none;
            position: fixed;
            top: 0; left: 0;
            width: 100%; height: 100%;
            background: rgba(0,0,0,0.6);
            z-index: 9999;
            justify-content: center;
            align-items: center;
            flex-direction: column;
        }

        .loading-overlay.show {
            display: flex;
        }

        .loading-box {
            background: white;
            padding: 40px;
            border-radius: 16px;
            text-align: center;
            box-shadow: 0 10px 40px rgba(0,0,0,0.2);
        }

        .loading-spinner {
            width: 60px;
            height: 60px;
            border: 6px solid #f3f3f3;
            border-top: 6px solid #1a6b3c;
            border-radius: 50%;
            animation: spin 1s linear infinite;
            margin: 0 auto 20px;
        }

        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        /* History table */
        .history-section {
            margin-top: 40px;
        }

        .badge-crd {
            background-color: #e74c3c;
