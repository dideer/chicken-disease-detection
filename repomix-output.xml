            <!-- Healthy Results -->
            <div class="col-md-4 mb-3">
                <div class="stat-card">
                    <div class="stat-icon" style="color: #27ae60;">
                        <i class="fas fa-heart"></i>
                    </div>
                    <div class="stat-number" 
