        <!-- Upload Section -->
        <div class="row">
            <div class="col-lg-8">
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-body p-4">

                        <!-- Upload Zone -->
                        <div class="upload-zone" 
                             id="uploadZone" 
                             onclick="document.getElementById('fileInput').click();">
                            <i class="fas fa-camera upload-icon"></i>
                            <h5 class="mb-2" data-lang-key="upload_label">
                                Upload Chicken Image
                            </h5>
                            <p class="text-muted" 
                               data-lang-key="upload_instructions">
                                Click to select or drag and drop
                            </p>
                            <input type="file" 
                                   id="fileInput" 
                                   accept="image/*" 
                                   style="display: none;">
                        </div>

                        <!-- Image Preview -->
                        <div class="image-preview-container" 
                             id="previewContainer">
                            <img id="preview" 
                                 class="image-preview" 
                                 alt="Preview">

                            <div class="file-info">
                                <strong>
                                    <i class="fas fa-file me-2"></i>
                                    <span data-lang-key="filename">
                                        Filename
                                    </span>:
                                </strong>
                                <span id="fileName"></span>
                                <br>
                                <strong>
                                    <i class="fas fa-database me-2"></i>
                                    <span data-lang-key="file_size">
                                        File Size
                                    </span>:
                                </strong>
                                <span id="fileSize"></span>
                            </div>

                            <!-- Error Alert -->
                            <div class="alert alert-danger mt-3 d-none" 
                                 id="errorAlert">
